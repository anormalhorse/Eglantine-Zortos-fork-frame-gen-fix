#version 460 core

// Converts the VK_NV_optical_flow output (VK_FORMAT_R16G16_SFIXED5_NV, copied to a buffer as one
// packed 32-bit word per grid cell) to a two-channel float motion image in full-resolution
// pixels, which is the format the frame interpolation shader expects.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer FlowBuffer {
    uint flow_data[];
};

layout(binding = 1, rg16f) uniform writeonly image2D OutMotion;

layout(push_constant) uniform PushConstants {
    ivec2 flow_size;
    float scale; // sign / 32.0 (S10.5 fixed point)
};

void main() {
    const ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= flow_size.x || coord.y >= flow_size.y) {
        return;
    }

    const int word = int(flow_data[uint(coord.y) * uint(flow_size.x) + uint(coord.x)]);
    const int x = bitfieldExtract(word, 0, 16);
    const int y = bitfieldExtract(word, 16, 16);

    imageStore(OutMotion, coord, vec4(vec2(float(x), float(y)) * scale, 0.0, 0.0));
}
